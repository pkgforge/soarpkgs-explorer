{
	"name": "soarpkgs-explorer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"data": "bun run scripts/metadata/build.ts",
		"build": "bun run data && bun run og && vite build",
		"preview": "vite preview",
		"og": "bun run scripts/build-og.ts",
		"og:preview": "bun run scripts/og-preview.ts",
		"seo": "bun run scripts/seo-check.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p scripts && bun run seo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@noble/curves": "^2.2.0",
		"@noble/hashes": "^2.2.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bun": "^1.4.3",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^7.0.0",
		"vite": "^8.0.16"
	}
}
